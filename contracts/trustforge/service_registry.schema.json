{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustforge.local/contracts/service_registry.schema.json",
  "title": "TrustForge ServiceRegistry",
  "type": "object",
  "required": ["schema_name", "registry_version", "services"],
  "properties": {
    "schema_name": { "const": "trustforge_service_registry" },
    "registry_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "generated_at_utc": { "type": "string", "format": "date-time" },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/service" }
    }
  },
  "$defs": {
    "service": {
      "type": "object",
      "required": [
        "service_id",
        "provider",
        "category",
        "endpoint_url",
        "method",
        "network",
        "asset",
        "last_observed_quote_usdc",
        "ground_truth_strategy",
        "status",
        "evidence_refs"
      ],
      "properties": {
        "service_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "provider": { "type": "string", "minLength": 1 },
        "category": {
          "enum": [
            "chain_metadata",
            "market_data",
            "prediction_market",
            "weather",
            "news"
          ]
        },
        "endpoint_url": { "type": "string", "pattern": "^https://" },
        "method": { "const": "GET" },
        "network": { "const": "eip155:8453" },
        "asset": { "const": "USDC" },
        "asset_address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "last_observed_quote_usdc": { "type": "string", "pattern": "^\\d+(\\.\\d+)?$" },
        "ground_truth_strategy": { "type": "string", "minLength": 1 },
        "ground_truth_determinism": {
          "enum": ["deterministic", "near_deterministic", "time_sensitive_cross_check", "subjective"]
        },
        "status": { "enum": ["proven_unpaid_handshake", "paid_verified", "deprecated"] },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_at_utc": { "type": "string" }
      }
    }
  }
}
