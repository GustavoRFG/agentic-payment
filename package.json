{
  "name": "agentic-payments-lab",
  "private": true,
  "version": "0.1.0",
  "description": "Agentic Payments Lab — controlled x402 buyer/seller prototypes for paid AI services.",
  "scripts": {
    "seller:install": "npm --prefix seller-api install",
    "seller:dev": "npm --prefix seller-api run dev",
    "seller:build": "npm --prefix seller-api run build",
    "buyer:install": "npm --prefix buyer-client install",
    "buyer:dev": "npm --prefix buyer-client run dev",
    "buyer:build": "npm --prefix buyer-client run build",
    "buyer:payment-check": "npm --prefix buyer-client run payment:check",
    "buyer:wallet-check": "npm --prefix buyer-client run wallet:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "catalog:smoke:testnet": "npm --prefix seller-api exec -- tsx tools/run-testnet-catalog-smoke.ts",
    "mainnet:check": "npm --prefix seller-api exec -- tsx tools/check-mainnet-readiness.ts",
    "mainnet:dry-run": "npm --prefix seller-api exec -- tsx tools/run-mainnet-unpaid-402-check.ts",
    "trustforge:probe:external:dry-run": "npm --prefix seller-api exec -- tsx tools/run-trustforge-external-probe-dry-run.ts",
    "trustforge:probe:external:paid-readiness": "npm --prefix seller-api exec -- tsx tools/run-trustforge-external-paid-smoke.ts",
    "trustforge:contracts:validate": "npm --prefix seller-api exec -- tsx tools/run-trustforge-contracts-validate.ts",
    "trustforge:evaluate:bootstrap": "npm --prefix seller-api exec -- tsx tools/run-trustforge-evaluate-bootstrap.ts",
    "trustforge:score:bootstrap": "npm --prefix seller-api exec -- tsx tools/run-trustforge-score-bootstrap.ts",
    "trustforge:registry:refresh-unpaid": "npm --prefix seller-api exec -- tsx tools/run-trustforge-registry-refresh-unpaid.ts",
    "trustforge:tx:ground-truth": "npm --prefix seller-api exec -- tsx tools/run-trustforge-build-tx-ground-truth.ts",
    "trustforge:rich-tx-explainer": "node ./seller-api/node_modules/tsx/dist/cli.mjs tools/run-trustforge-rich-tx-explainer.ts",
    "trustforge:rich-tx-explainer:paid": "node ./seller-api/node_modules/tsx/dist/cli.mjs tools/run-trustforge-rich-tx-explainer.ts --execute-paid",
    "trustforge:rich-tx-explainer:diagnostics": "node ./seller-api/node_modules/tsx/dist/cli.mjs tools/run-trustforge-rich-tx-explainer-diagnostics.ts",
    "trustforge:rich-tx-explainer:phase3b": "node ./seller-api/node_modules/tsx/dist/cli.mjs tools/run-trustforge-rich-tx-explainer-phase3b.ts",
    "trustforge:rich-tx-explainer:reconcile-settlements": "node ./seller-api/node_modules/tsx/dist/cli.mjs tools/run-trustforge-reconcile-settlements.ts",
    "trustforge:phase4:architecture": "node ./seller-api/node_modules/tsx/dist/cli.mjs tools/run-trustforge-phase4-architecture.ts",
    "trustforge:phase4:replay": "node ./seller-api/node_modules/tsx/dist/cli.mjs tools/trustforge/replay-phase3b-settlements.ts",
    "trustforge:phase4:invariants": "node ./seller-api/node_modules/tsx/dist/cli.mjs tools/run-trustforge-phase4-invariants.ts",
    "trustforge:phase5:discovery": "node ./seller-api/node_modules/tsx/dist/cli.mjs tools/run-trustforge-phase5-rich-provider-discovery.ts",
    "trustforge:rich:assert-invariants": "node ./seller-api/node_modules/tsx/dist/cli.mjs tools/run-trustforge-rich-invariants.ts",
    "mcp:build": "npm --prefix mcp-gateway run build",
    "mcp:dev": "npm --prefix mcp-gateway run dev",
    "mcp:smoke": "npm --prefix seller-api exec -- tsx tools/smoke-local-mcp-gateway.ts",
    "logs:summary": "npm --prefix seller-api exec -- tsx tools/log-summary.ts",
    "logs:summary:json": "npm --prefix seller-api exec -- tsx tools/log-summary.ts --json",
    "logs:tail:seller": "powershell -NoProfile -Command \"Get-Content -Wait logs/seller-events.jsonl\"",
    "logs:tail:buyer": "powershell -NoProfile -Command \"Get-Content -Wait logs/buyer-events.jsonl\"",
    "dashboard:render": "npm --prefix seller-api exec -- tsx tools/render-dashboard.ts",
    "dashboard:open": "powershell -NoProfile -Command \"Start-Process dashboard/index.html\"",
    "dashboard:refresh": "npm run dashboard:render && npm run dashboard:open",
    "dashboard:export": "npm --prefix seller-api exec -- tsx tools/export-dashboard.ts",
    "dashboard:list-exports": "npm --prefix seller-api exec -- tsx tools/list-dashboard-exports.ts",
    "snapshot:validate:sample": "npm --prefix seller-api exec -- tsx tools/validate-defi-guardian-snapshot.ts --file seller-api/src/adapters/defi-guardian/defiGuardianSnapshotV1.sample.json",
    "snapshot:export:local": "npm --prefix seller-api exec -- tsx tools/export-local-defi-guardian-snapshot.ts",
    "snapshot:validate:local": "npm --prefix seller-api exec -- tsx tools/validate-defi-guardian-snapshot.ts --file runtime/defi-guardian-snapshots/latest.json",
    "snapshot:refresh:local": "npm run snapshot:export:local && npm run snapshot:validate:local",
    "demo:local": "npm --prefix seller-api exec -- tsx tools/run-local-demo.ts",
    "demo:real-file": "npm --prefix seller-api exec -- tsx tools/run-real-file-demo.ts",
    "demo:real-local-file": "npm --prefix seller-api exec -- tsx tools/run-real-local-snapshot-demo.ts",
    "demo:paid-real-local-dry-run": "npm --prefix seller-api exec -- tsx tools/run-paid-real-local-dry-run.ts",
    "demo:paid-real-local-controlled": "npm --prefix seller-api exec -- tsx tools/run-paid-real-local-controlled-payment.ts",
    "install:all": "npm --prefix seller-api install && npm --prefix buyer-client install"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "vitest": "^2.1.0"
  }
}
