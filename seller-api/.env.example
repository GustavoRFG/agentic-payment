# Agentic Payments Lab — seller-api
# Copy to .env and fill in testnet-only values. NEVER commit .env.

# HTTP port the seller listens on.
PORT=4021

# Base Sepolia testnet address that should receive x402 payments.
# This is the only address tokens will be sent to once payment is enabled.
# Replace with an address you control. Do NOT use a mainnet address.
SELLER_RECEIVER_ADDRESS=0xYOUR_TESTNET_RECEIVER_ADDRESS

# Price for the paid mock report, dollar-prefixed (e.g. "$0.001").
# Omitting the leading "$" triggers @x402/express validation errors.
REPORT_PRICE_USD=$0.001

# Open testnet facilitator that requires no signup. Mainnet would use
# https://api.cdp.coinbase.com/platform/v2/x402 with CDP API credentials.
X402_FACILITATOR_URL=https://x402.org/facilitator

# CAIP-2 network ID. Base Sepolia = eip155:84532. Do not change to mainnet.
X402_NETWORK=eip155:84532
