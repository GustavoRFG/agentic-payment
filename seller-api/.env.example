# Agentic Payments Lab — seller-api
# Copy to .env and fill in values. NEVER commit .env.

# HTTP port the seller listens on.
PORT=4021

# Base address that should receive x402 payments.
# This is the only address tokens will be sent to once payment is enabled.
# Replace with an address you control. Use a dedicated production receiver
# before enabling mainnet.
SELLER_RECEIVER_ADDRESS=0xYOUR_TESTNET_RECEIVER_ADDRESS

# Price for the paid mock report, dollar-prefixed (e.g. "$0.001").
# Omitting the leading "$" triggers @x402/express validation errors.
REPORT_PRICE_USD=$0.001

# Network selection. Default is Base Sepolia testnet.
# Set X402_USE_MAINNET=1 only for production Base mainnet with real USDC.
# Mainnet uses the CDP production facilitator automatically.
# X402_USE_MAINNET=1

# Legacy/test tooling network guard. Base Sepolia = eip155:84532.
X402_NETWORK=eip155:84532
