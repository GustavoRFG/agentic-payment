# Agentic Payments Lab - buyer-client
# Copy to .env and fill in local values. NEVER commit .env.

# Private key for a fresh dedicated wallet.
# Generate a new one for this lab - do NOT reuse any wallet that ever held
# mainnet value unless it is the dedicated production wallet.
# This placeholder is intentionally not a real key.
BUYER_PRIVATE_KEY=0xTESTNET_ONLY_PRIVATE_KEY_DO_NOT_USE_REAL_FUNDS

# URL of the local seller-api.
SELLER_BASE_URL=http://localhost:4021

# Hard ceiling on what the buyer will ever pay, in USD.
# Even in --pay mode, the buyer refuses to sign anything above this number.
MAX_PAYMENT_USD=0.001

# CAIP-2 network identifier. Base Sepolia testnet = eip155:84532.
# Testnet remains the default. Mainnet is selected by X402_USE_MAINNET=1.
X402_NETWORK=eip155:84532

# Mainnet local-only controls.
# Do not enable until the dedicated production wallets are funded intentionally.
# X402_USE_MAINNET=1
# Required only before an explicit --pay mainnet run.
# MAINNET_PAYMENT_CONFIRMATION=ONE_BASE_MAINNET_PAYMENT

# Optional: text to analyze (default: built-in sample)
BUYER_SAMPLE_TEXT=

# Optional: analysis mode - summary | sentiment | entities | full (default: full)
BUYER_ANALYSIS_MODE=full
